{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": {
      "width": 20
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  SYSTEM  \u001b[38;5;8m────────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "  \u001b[38;5;5mOS\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;5;5mKernel\u001b[0m"
    },
    {
      "type": "de",
      "key": "  \u001b[38;5;5mDesktop\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;5;5mWM\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;5;5mTerminal\u001b[0m"
    },
    {
      "type": "terminalfont",
      "key": "  \u001b[38;5;5mFont\u001b[0m"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;5;5mShell\u001b[0m"
    },
    {
      "type": "packages",
      "key": "  \u001b[38;5;5mPackages\u001b[0m"
    },
    {
      "type": "locale",
      "key": "  \u001b[38;5;5mLocale\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌───────────────────────────────────────\u001b[38;5;7m  HARDWARE  \u001b[38;5;8m───────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": "  \u001b[38;5;6mHost\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;5;6mCPU\u001b[0m"
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;5;6mGPU\u001b[0m"
    },
    {
      "type": "display",
      "key": "  \u001b[38;5;6mResolution\u001b[0m"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;5;6mMemory\u001b[0m"
    },
    {
      "type": "swap",
      "key": "  \u001b[38;5;6mSwap\u001b[0m"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;5;6mDisk\u001b[0m",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  STATUS  \u001b[38;5;8m────────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "datetime",
      "key": "  \u001b[38;5;4mDate\u001b[0m"
    },
    {
      "type": "processes",
      "key": "  \u001b[38;5;4mProcesses\u001b[0m"
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4mRoot FS date\u001b[0m",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null) && [ \"$b\" -gt 0 ] 2>/dev/null && date -d \"@$b\" \"+%d.%m.%Y %H:%M\" 2>/dev/null || printf \"N/A\\n\""
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4mRoot FS age\u001b[0m",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null); n=$(date +%s); if [ \"$b\" -gt 0 ] 2>/dev/null && [ \"$b\" -le \"$n\" ]; then printf \"%s days\\n\" \"$(( (n-b)/86400 ))\"; else printf \"N/A\\n\"; fi"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;5;4mUptime\u001b[0m"
    },
    {
      "type": "battery",
      "key": "  \u001b[38;5;4mBattery\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "colors"
    }
  ]
}
