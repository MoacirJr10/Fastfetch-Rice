{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": {
      "width": 18
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": 9
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii-compact.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌─────────────────────\u001b[38;5;7m  SYSTEM  \u001b[38;5;8m─────────────────────┐"
    },
    {
      "type": "os",
      "key": "  \u001b[38;5;5m  OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;5;5m  Kernel",
      "format": "{sysname} {release}"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;5;5m  Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────\u001b[38;5;7m  HARDWARE  \u001b[38;5;8m────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;5;6m  CPU",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;5;6m󰢮  GPU",
      "format": "{name} ({type}, {driver})"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;5;6m  Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;5;6m  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}  [{mountpoint}]"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌─────────────────────\u001b[38;5;7m  STATUS  \u001b[38;5;8m─────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;5;4m  Uptime",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "battery",
      "key": "  \u001b[38;5;4m  Battery",
      "format": "{capacity} - {status}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;1m  \u001b[38;5;2m  \u001b[38;5;3m  \u001b[38;5;4m  \u001b[38;5;5m  \u001b[38;5;6m  \u001b[38;5;7m  \u001b[38;5;8m \u001b[0m"
    }
  ]
}
