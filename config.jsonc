{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": {
      "width": 20
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  SYSTEM  \u001b[38;5;8m────────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "  \u001b[38;5;5m  OS\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;5;5m  Kernel\u001b[0m"
    },
    {
      "type": "de",
      "key": "  \u001b[38;5;5m  Desktop\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;5;5m  WM\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;5;5m  Terminal\u001b[0m"
    },
    {
      "type": "terminalfont",
      "key": "  \u001b[38;5;5m󰛖  Font\u001b[0m"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;5;5m  Shell\u001b[0m"
    },
    {
      "type": "packages",
      "key": "  \u001b[38;5;5m  Packages\u001b[0m"
    },
    {
      "type": "locale",
      "key": "  \u001b[38;5;5m  Locale\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌───────────────────────────────────────\u001b[38;5;7m  HARDWARE  \u001b[38;5;8m───────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": "  \u001b[38;5;6m  Host\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;5;6m  CPU\u001b[0m"
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;5;6m󰢮  GPU\u001b[0m"
    },
    {
      "type": "display",
      "key": "  \u001b[38;5;6m󰍹  Resolution\u001b[0m"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;5;6m  Memory\u001b[0m"
    },
    {
      "type": "swap",
      "key": "  \u001b[38;5;6m  Swap\u001b[0m"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;5;6m  Disk\u001b[0m",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  STATUS  \u001b[38;5;8m────────────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "datetime",
      "key": "  \u001b[38;5;4m  Date\u001b[0m"
    },
    {
      "type": "processes",
      "key": "  \u001b[38;5;4m  Processes\u001b[0m"
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4m  Root FS date\u001b[0m",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null) && [ \"$b\" -gt 0 ] 2>/dev/null && date -d \"@$b\" \"+%d.%m.%Y %H:%M\" 2>/dev/null || printf \"N/A\\n\""
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4m  Root FS age\u001b[0m",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null); n=$(date +%s); if [ \"$b\" -gt 0 ] 2>/dev/null && [ \"$b\" -le \"$n\" ]; then printf \"%s days\\n\" \"$(( (n-b)/86400 ))\"; else printf \"N/A\\n\"; fi"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;5;4m  Uptime\u001b[0m"
    },
    {
      "type": "battery",
      "key": "  \u001b[38;5;4m  Battery\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "colors"
    }
  ]
}
