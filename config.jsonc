{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": {
      "width": 20
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": 9
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  SYSTEM  \u001b[38;5;8m────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  \u001b[38;5;5m  OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;5;5m  Kernel",
      "format": "{sysname} {release}"
    },
    {
      "type": "de",
      "key": "  \u001b[38;5;5m  Desktop",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;5;5m  WM",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;5;5m  Terminal",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "  \u001b[38;5;5m󰛖  Font",
      "format": "{name}"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;5;5m  Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "packages",
      "key": "  \u001b[38;5;5m  Packages"
    },
    {
      "type": "locale",
      "key": "  \u001b[38;5;5m  Locale",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌───────────────────────────────────────\u001b[38;5;7m  HARDWARE  \u001b[38;5;8m───────────────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "  \u001b[38;5;6m  Host",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;5;6m  CPU",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;5;6m󰢮  GPU",
      "format": "{name} ({type}, {driver})"
    },
    {
      "type": "display",
      "key": "  \u001b[38;5;6m󰍹  Resolution",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;5;6m  Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "  \u001b[38;5;6m  Swap",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;5;6m  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}  [{mountpoint}]"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m┌────────────────────────────────────────\u001b[38;5;7m  STATUS  \u001b[38;5;8m────────────────────────────────────────┐"
    },
    {
      "type": "datetime",
      "key": "  \u001b[38;5;4m  Date",
      "format": "{day-in-month}.{month-pretty}.{year}  {hour-pretty}:{minute-pretty}:{second-pretty}"
    },
    {
      "type": "processes",
      "key": "  \u001b[38;5;4m  Processes",
      "format": "{result} running"
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4m  Root FS date",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null) && [ \"$b\" -gt 0 ] 2>/dev/null && date -d \"@$b\" \"+%d.%m.%Y %H:%M\" 2>/dev/null || printf \"N/A\\n\""
    },
    {
      "type": "command",
      "key": "  \u001b[38;5;4m  Root FS age",
      "shell": "/bin/sh",
      "text": "b=$(stat -c %W / 2>/dev/null); n=$(date +%s); if [ \"$b\" -gt 0 ] 2>/dev/null && [ \"$b\" -le \"$n\" ]; then printf \"%s days\\n\" \"$(( (n-b)/86400 ))\"; else printf \"N/A\\n\"; fi"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;5;4m  Uptime",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "battery",
      "key": "  \u001b[38;5;4m  Battery",
      "format": "{capacity} - {status}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;8m└──────────────────────────────────────────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "                                                                    \u001b[38;5;1m  \u001b[38;5;2m  \u001b[38;5;3m  \u001b[38;5;4m  \u001b[38;5;5m  \u001b[38;5;6m  \u001b[38;5;7m  \u001b[38;5;8m \u001b[0m"
    }
  ]
}
